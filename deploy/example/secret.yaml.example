# Copy this file only into a private GitOps repository, encrypt it with that
# repository's SealedSecrets workflow, and remove the literal placeholder file.
apiVersion: v1
kind: Secret
metadata:
  name: volcano-cert-sync-credentials
  namespace: cert-sync-example
type: Opaque
stringData:
  VOLCENGINE_ACCESS_KEY: replace-with-least-privilege-access-key
  VOLCENGINE_SECRET_KEY: replace-with-least-privilege-secret-key
