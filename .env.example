# Local development configuration. Copy this file to .env and replace only the
# placeholder values. .env is ignored by Git and Docker build context.

# Volcengine credentials. Use a least-privilege service identity in production.
VOLCENGINE_ACCESS_KEY=your-access-key-here
VOLCENGINE_SECRET_KEY=your-secret-key-here

# Kubernetes TLS Secret to reconcile.
K8S_SECRET_NAME=source-tls-secret
K8S_SECRET_NAMESPACE=example-namespace

# Explicit targets: domain:type, comma separated.
# Valid types: cdn (standard CDN), dcdn (Dynamic CDN), mcdn (Multi-cloud CDN).
# Do not use a bare domain in new configuration: it is retained only for a
# legacy CDN compatibility path.
SYNC_TARGETS=api.example.com:dcdn,media.example.com:mcdn

# Legacy standard-CDN-only configuration, used only if SYNC_TARGETS is absent.
# CDN_DOMAINS=legacy.example.com

# Optional: perform the full Kubernetes/cloud/public-TLS reconciliation without
# importing or binding a certificate.
# DRY_RUN=true

# Optional: import the certificate into Certificate Center without deploying.
# Used for MCDN built-in CDN domains, which have no public deploy API; the
# binding is a manual console step that references the uploaded instance.
# UPLOAD_ONLY=true
